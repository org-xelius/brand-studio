{
  "name": "@local/brand-studio",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "A guided social design studio for companies, campaigns, and weekly creative work.",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "host.js",
    "index.js",
    "image-errors.js",
    "font-service.js",
    "font-catalog.js",
    "welcome-artwork-task.js",
    "home-model.js",
    "model.js",
    "poster-model.js",
    "composition-model.js",
    "template-model.js",
    "font-pairings.js",
    "src/font-passports-template.js",
    "motif-resources.js",
    "src/layout-kernel-flex.js",
    "src/layout-kernel-template.js",
    "src/font-passports-v3.js",
    "assets",
    "client.js",
    "icon.svg",
    "cordis.patch.yml",
    "locale",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test *.test.js tests/renderer.test.mjs",
    "test:visual": "node --test tests/renderer-visual.test.mjs",
    "test:visual:v3": "node --test tests/renderer-v3.test.mjs",
    "test:export": "node --test tests/renderer-crisp.test.mjs",
    "test:ui": "BS_LOOK_TEN_UI_READY=1 node tests/look-ten-ui.mjs",
    "test:company-colors": "node --test company-colors.test.js tests/renderer-company-colors.test.mjs && node tests/company-colors-ui.mjs",
    "test:export:flex": "node --test --test-concurrency=1 tests/renderer-flex*.test.mjs",
    "test:ui:flex": "BS_LOOK_TEN_UI_READY=1 node tests/look-ten-ui.mjs",
    "test:export:templates": "node --test --test-concurrency=1 tests/template-native.test.mjs",
    "test:ui:look": "BS_LOOK_TEN_UI_READY=1 node tests/look-ten-ui.mjs",
    "check": "node --check index.js && node --check model.js && node --check poster-model.js && node --check composition-model.js && node --check motif-resources.js && node --check src/layout-kernel-flex.js && node --check template-model.js && node --check src/layout-kernel-template.js && node --check src/poster-renderer-template.js && node --check font-pairings.js && node --check src/fonts-template.js"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "engines": {
    "dsh": "^0.2.2-rc.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "esbuild": "^0.25.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
